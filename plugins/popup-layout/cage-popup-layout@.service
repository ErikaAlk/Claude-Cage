[Unit]
Description=Cage native extension popup layout
Requires=cage-browser.service cage-native-ui-firewall.service
After=cage-browser.service cage-native-ui-firewall.service
PartOf=cage-browser.service
[Service]
User=cage-native-ui
Group=cage-browser
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/bin/node /usr/local/lib/browser-popup-layout.mjs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=256M
